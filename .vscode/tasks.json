// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
// Default build task for debugging from the monorepo root: compiles the vscode
// extension package in watch mode (delegates to packages/vscode's "watch" script).
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
